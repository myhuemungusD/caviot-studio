{
  "name": "caviot-studio",
  "private": true,
  "description": "Caviot Studio: browser-based 3D sleeve designer (static Three.js app in dist/, iOS/Android in mobile/, Mac in desktop/).",
  "license": "UNLICENSED",
  "scripts": {
    "serve": "node serve.mjs",
    "test": "node tests.mjs",
    "build:sw": "node build-sw.mjs",
    "lint:changed": "git diff --name-only --diff-filter=ACMR origin/main...HEAD -- '*.js' '*.mjs' | xargs -r eslint",
    "format:changed": "git diff --name-only --diff-filter=A origin/main...HEAD -- '*.js' '*.mjs' '*.css' '*.json' | xargs -r prettier --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.0"
  }
}
