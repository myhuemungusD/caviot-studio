root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{js,mjs,css,html,json,webmanifest,yml,yaml}]
indent_style = space
indent_size = 2

[*.{java,kt,swift,gradle}]
indent_style = space
indent_size = 4

[*.{cmd,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
