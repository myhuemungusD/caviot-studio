				<array>
					<string>model/obj</string>
					<string>text/prs.wavefront-obj</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.3mf</string>
			<key>UTTypeDescription</key>
			<string>3MF 3D model</string>
