			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>3mf</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>model/3mf</string>
					<string>application/vnd.ms-package.3dmanufacturing-3dmodel+xml</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>3D sleeve template</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.standard-tesselated-geometry-format</string>
				<string>public.geometry-definition-format</string>
				<string>com.microsoft.3mf</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
