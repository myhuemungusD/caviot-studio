# Keep text line endings stable; never diff/merge binary assets as text.
* text=auto
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.wasm binary
*.onnx binary
*.mesh binary
*.stl binary
*.3mf binary
*.f32 binary
*.bat text eol=crlf
